{
    "name": "j0k3r/f43.me",
    "description": "A More readable & cleaner feed",
    "license": "MIT",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Jeremy Benoist",
            "email": "jeremy.benoist@gmail.com",
            "homepage": "http://www.j0k3r.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "beberlei/doctrineextensions": "^1.2",
        "composer/package-versions-deprecated": "^1.11",
        "doctrine/dbal": "4.5.x-dev",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.5",
        "gedmo/doctrine-extensions": "^3.20",
        "j0k3r/graby-site-config": "^1",
        "j0k3r/php-imgur-api-client": "~4.0",
        "laminas/laminas-code": "^4.5",
        "php-http/guzzle7-adapter": "^1.0",
        "php-http/httplug-bundle": "^2.1",
        "sentry/sentry-symfony": "^5.0",
        "simplepie/simplepie": "^1.8",
        "stof/doctrine-extensions-bundle": "^1.14",
        "symfony/amqp-messenger": "^7.4|^8.0",
        "symfony/asset": "^7.4|^8.0",
        "symfony/asset-mapper": "^7.4|^8.0",
        "symfony/dotenv": "^7.4|^8.0",
        "symfony/flex": "^2.8",
        "symfony/form": "^7.4|^8.0",
        "symfony/lock": "^7.4|^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "^7.4|^8.0",
        "symfony/security-bundle": "^7.4|^8.0",
        "symfony/translation": "^7.4|^8.0",
        "symfony/twig-bundle": "^7.4|^8.0",
        "symfony/validator": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0",
        "tacman/graby": "dev-tac",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "friendsofphp/php-cs-fixer": "~3.0",
        "jawira/doctrine-diagram-bundle": "^1.2",
        "php-http/mock-client": "^1.3",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.1",
        "symfony/browser-kit": "^7.4|^8.0",
        "symfony/css-selector": "^7.4|^8.0",
        "symfony/debug-bundle": "^7.4|^8.0",
        "symfony/phpunit-bridge": "^7.4|^8.0",
        "symfony/stopwatch": "^7.4|^8.0",
        "symfony/web-profiler-bundle": "^7.4|^8.0"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    },
    "config": {
        "bin-dir": "bin",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^8.1",
            "docker": true
        }
    }
}
